<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Prayer Interaction App</title>
    <style>
        * { box-sizing: border-box; -webkit-user-select: none; user-select: none; }
        body { margin: 0; padding: 0; background-color: #000; color: #fff; font-family: sans-serif; display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
        
        /* 메인 터치 영역 */
        #app-screen { flex: 1; display: flex; justify-content: center; align-items: center; relative; overflow: hidden; cursor: pointer; }
        
        /* 은은한 빛 효과 (기본 투명도 0) */
        #glow { position: absolute; width: 300px; height: 300px; background: radial-gradient(circle, rgba(255,253,230,0.6) 0%, rgba(0,0,0,0) 70%); border-radius: 50%; opacity: 0; transition: opacity 0.3s ease; pointer-events: none; }
        
        /* 손 이미지 */
        #hands { width: 200px; height: auto; z-index: 10; pointer-events: none; filter: drop-shadow(0 0 10px rgba(0,0,0,0.5)); }
        
        /* 하단 인터페이스 (종교 선택) */
        #interface { height: 80px; background-color: #111; display: flex; border-top: 1px solid #333; z-index: 20; }
        .tab { flex: 1; display: flex; justify-content: center; align-items: center; font-size: 14px; color: #888; border-right: 1px solid #222; cursor: pointer; }
        .tab: last-child { border-right: none; }
        .tab.active { color: #fff; background-color: #222; font-weight: bold; }
    </style>
</head>
<body>

    <div id="app-screen">
        <div id="glow"></div>
        <img id="hands" src="hands_default.png" alt="Hands">
    </div>

    <div id="interface">
        <div class="tab active" onclick="selectReligion('buddhism', this)">불교</div>
        <div class="tab" onclick="selectReligion('christian', this)">기독교</div>
        <div class="tab" onclick="selectReligion('catholic', this)">천주교</div>
    </div>

    <audio id="audio-buddhism" src="buddhism.mp3" loop></audio>
    <audio id="audio-christian" src="christian.mp3" loop></audio>
    <audio id="audio-catholic" src="catholic.mp3" loop></audio>

    <script>
        let currentReligion = 'buddhism';
        const screen = document.getElementById('app-screen');
        const glow = document.getElementById('glow');
        const hands = document.getElementById('hands');

        // 종교 변경 함수
        function selectReligion(religion, element) {
            // 모든 오디오 일단 정지
            stopAllAudio();
            currentReligion = religion;
            
            // 탭 스타일 변경
            document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
            element.classList.add('active');
        }

        function stopAllAudio() {
            document.getElementById('audio-buddhism').pause();
            document.getElementById('audio-buddhism').currentTime = 0;
            document.getElementById('audio-christian').pause();
            document.getElementById('audio-christian').currentTime = 0;
            document.getElementById('audio-catholic').pause();
            document.getElementById('audio-catholic').currentTime = 0;
        }

        // 터치 시작 (정역학적 반응)
        function startInteraction(e) {
            e.preventDefault();
            glow.style.opacity = '1'; // 빛 보이기
            hands.src = 'hands_pray.png'; // 필요시 합창하는 손 이미지로 교체 가능
            
            // 선택된 종교 음악 재생
            const currentAudio = document.getElementById(`audio-${currentReligion}`);
            if (currentAudio) currentAudio.play().catch(err => console.log("유저 인터랙션 필요"));
        }

        // 터치 종료
        function endInteraction(e) {
            glow.style.opacity = '0'; // 빛 숨기기
            hands.src = 'hands_default.png'; // 원래 손 이미지로 복귀
            
            // 음악 일시정지 및 처음으로 되돌리기
            const currentAudio = document.getElementById(`audio-${currentReligion}`);
            if (currentAudio) {
                currentAudio.pause();
                currentAudio.currentTime = 0; 
            }
        }

        // 마우스 및 모바일 터치 이벤트 연결
        screen.addEventListener('mousedown', startInteraction);
        screen.addEventListener('mouseup', endInteraction);
        screen.addEventListener('mouseleave', endInteraction);

        screen.addEventListener('touchstart', startInteraction);
        screen.addEventListener('touchend', endInteraction);
    </script>
</body>
</html>
